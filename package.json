{
  "name": "clips",
  "displayName": "ClipLib",
  "version": "3.5.18",
  "description": "A simple clipping gallery as a replacement for Steelseries Moments. Use it with any other clipping program.",
  "author": "yuma-dev",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:full": "npm run build:clipdip && npm run dev",
    "dev:trace": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron:trace\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "dev:electron:trace": "wait-on tcp:127.0.0.1:5173 && node scripts/electron-trace.js",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:clipdip && npm run vendor:clipdip && npm run build:launcher && npm run vendor:launcher && node scripts/gen-ingest-key.mjs && electron-builder --win",
    "build:clipdip": "node scripts/sync-clipdip-version.mjs && cd clipdip && npm install --no-audit --no-fund && npm run build && node -e \"const fs=require('fs'),d=new Date();fs.utimesSync('src-tauri/src/main.rs',d,d)\" && cargo build --release -p clipdip",
    "vendor:clipdip": "node scripts/vendor-clipdip.mjs",
    "release": "node scripts/release.mjs",
    "release:preview": "node scripts/release-preview.mjs",
    "bench:build": "node scripts/kill-dist-app.mjs && vite build && node scripts/vendor-launcher.mjs && electron-builder --win --dir",
    "bench:startup": "npm run bench:build && node benchmark/cold-start.js --label check --runs 5 --reuse --assert",
    "benchmark": "node benchmark/runner.js",
    "benchmark:verbose": "node benchmark/runner.js --verbose",
    "benchmark:json": "node benchmark/runner.js --output json",
    "benchmark:openclip": "node benchmark/runner.js --suite openclip --verbose",
    "export:extract": "node scripts/export-extract-clip.mjs",
    "export:capture": "node scripts/export-capture.mjs",
    "export:overlay": "node scripts/export-overlay.mjs",
    "build:launcher": "cd clipdip && cargo build --release -p cliplib-launcher",
    "vendor:launcher": "node scripts/vendor-launcher.mjs"
  },
  "build": {
    "appId": "com.yuma-dev.clips",
    "productName": "ClipLib",
    "extraMetadata": {
      "description": "ClipLib"
    },
    "protocols": [
      {
        "name": "ClipLib",
        "schemes": [
          "cliplib"
        ]
      }
    ],
    "files": [
      "main/**/*",
      "utils/**/*",
      "player-legacy/**/*",
      "renderer-dist/**/*",
      "diagnostics/**/*.js",
      "*.js",
      "*.json",
      "*.html",
      "icon.ico",
      "!package-lock.json"
    ],
    "extraResources": [
      {
        "from": "vendor/clipdip/",
        "to": "clipdip/"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/bin/${os}/${arch}/ffmpeg",
      "node_modules/@ffprobe-installer/ffprobe/bin/${os}/${arch}/ffprobe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "appId": "com.yuma-dev.clips"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipLib",
      "uninstallDisplayName": "ClipLib",
      "artifactName": "ClipLib Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "vendor/launcher/ClipLib Launcher.exe",
        "to": "ClipLib Launcher.exe"
      }
    ]
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "concurrently": "^10.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "node-webpmux": "^3.2.1",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "discord-rpc": "^4.0.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "semver": "^7.6.3",
    "smol-toml": "^1.7.0"
  }
}
