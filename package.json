{
  "name": "clips",
  "displayName": "ClipLib",
  "version": "2.1.0",
  "description": "A simple clipping gallery as a replacement for Steelseries Moments. Use it with any other clipping program.",
  "author": "yuma-dev",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:trace": "concurrently -k -n vite,electron -c cyan,green \"npm:dev:renderer\" \"npm:dev:electron:trace\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "dev:electron:trace": "wait-on tcp:127.0.0.1:5173 && node scripts/electron-trace.js",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win",
    "vendor:clipper": "node scripts/vendor-clipper.mjs",
    "benchmark": "node benchmark/runner.js",
    "benchmark:verbose": "node benchmark/runner.js --verbose",
    "benchmark:json": "node benchmark/runner.js --output json",
    "benchmark:openclip": "node benchmark/runner.js --suite openclip --verbose"
  },
  "build": {
    "appId": "com.yuma-dev.clips",
    "productName": "ClipLib",
    "protocols": [
      {
        "name": "ClipLib",
        "schemes": [
          "cliplib"
        ]
      }
    ],
    "files": [
      "assets/**/*",
      "main/**/*",
      "utils/**/*",
      "player-legacy/**/*",
      "renderer-dist/**/*",
      "diagnostics/**/*.js",
      "*.js",
      "*.json",
      "*.html",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "vendor/clipper/",
        "to": "clipper/"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/bin/${os}/${arch}/ffmpeg",
      "node_modules/@ffprobe-installer/ffprobe/bin/${os}/${arch}/ffprobe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "appId": "com.yuma-dev.clips"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipLib",
      "uninstallDisplayName": "ClipLib",
      "artifactName": "ClipLib Setup ${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "concurrently": "^10.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "archiver": "^7.0.1",
    "axios": "^1.7.2",
    "chokidar": "^3.6.0",
    "custom-electron-titlebar": "^4.2.8",
    "discord-rpc": "^4.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "readify": "^10.0.0",
    "semver": "^7.6.3",
    "smol-toml": "^1.7.0"
  }
}
