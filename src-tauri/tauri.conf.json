{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipdip",
  "version": "0.1.0",
  "identifier": "com.clipdip.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run fetch-ffmpeg && npm run dev",
    "beforeBuildCommand": "npm run build && npm run fetch-ffmpeg"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../dist/ffmpeg-cache/ffmpeg.exe": "ffmpeg.exe",
      "../dist/ATTRIBUTION.txt": "ATTRIBUTION.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
